<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.jacolp</groupId>
    <artifactId>middleware</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>middleware</name>
    <description>middleware</description>

    <modules>
        <module>middleware-dependencies</module>
        <module>middleware-common</module>
        <module>middleware-framework</module>
        <module>middleware-module-system</module>
        <module>middleware-module-note</module>
        <module>middleware-module-media</module>
        <module>middleware-module-audit</module>
        <module>middleware-module-audio</module>
        <module>middleware-open-api-agent</module>

        <module>middleware-server</module>
    </modules>

    <properties>
        <spring-boot.version>4.0.5</spring-boot.version>
        <middleware.version>0.0.1-SNAPSHOT</middleware.version>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven-enforcer.version>3.5.0</maven-enforcer.version>
        <mybatis>4.0.1</mybatis>
        <pagehelper>2.1.0</pagehelper>
        <lombok>1.18.38</lombok>
        <lombok.version>${lombok}</lombok.version>
        <mysql.connector.j>8.0.33</mysql.connector.j>
        <mysql.version>${mysql.connector.j}</mysql.version>
        <jjwt>0.9.1</jjwt>
        <knife4j>4.3.0</knife4j>
        <spring-security.crypto>6.4.5</spring-security.crypto>
        <httpclient>4.5.14</httpclient>
        <openapi.webmvc.ui>2.7.0</openapi.webmvc.ui>
        <spring.aop>2.3.8.RELEASE</spring.aop>
        <mockito.all>1.9.5</mockito.all>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.jacolp</groupId>
                <artifactId>middleware-dependencies</artifactId>
                <version>${middleware.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer.version}</version>
                <executions>
                    <execution>
                        <id>enforce-java-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>This project must be built with JDK 21.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
