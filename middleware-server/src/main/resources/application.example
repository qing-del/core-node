# ============================================================
# application.example
#
# This file is a reference template only. Spring Boot does not load
# the .example extension automatically. Copy it to
# application-{profile}.yaml (for example, application-home.yaml),
# then select that profile with SPRING_PROFILES_ACTIVE or
# spring.profiles.active.
#
# Do not commit real passwords, tokens, access keys, or private keys.
# Aliyun OSS credentials are read from OSS_ACCESS_KEY_ID and
# OSS_ACCESS_KEY_SECRET environment variables and must not be placed here.
# ============================================================

spring:
  # Profile selection belongs in the non-profile-specific application.yaml.
  # The current project defaults to home; override it with
  # SPRING_PROFILES_ACTIVE, or uncomment the following when using this file
  # as application.yaml instead of application-{profile}.yaml:
  # profiles:
  #   active: ${SPRING_PROFILES_ACTIVE:home}
  application:
    name: middleware-server
  datasource:
    url: jdbc:mysql://${jacolp.datasource.host}:${jacolp.datasource.port}/${jacolp.datasource.database}
    username: ${jacolp.datasource.username}
    password: ${jacolp.datasource.password}
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      keep-alive-time: 50000  # 50 秒尝试一次保持 TCP 连接（可以用于分布式的时候防止 NAT 老化）
      connection-test-query: SELECT 1
      minimum-idle: 5
      maximum-pool-size: 20
  servlet:
    multipart:
      enabled: true
      max-file-size: 2MB
      max-request-size: 5MB
  data:
    redis:
      host: ${jacolp.redis.host}
      port: ${jacolp.redis.port}
      password: ${jacolp.redis.password}
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0
          max-wait: 100ms
  rabbitmq:
    host: ${RABBITMQ_HOST:${jacolp.rabbitmq.host}}
    port: ${RABBITMQ_PORT:${jacolp.rabbitmq.port}}
    username: ${RABBITMQ_USERNAME:${jacolp.rabbitmq.username}}
    password: ${RABBITMQ_PASSWORD:${jacolp.rabbitmq.password}}
    publisher-confirm-type: correlated
    listener:
      simple:
        default-requeue-rejected: false
        missing-queues-fatal: false
  mail:
    host: ${jacolp.mail.host}
    port: ${jacolp.mail.port}
    username: ${jacolp.mail.username}
    password: ${jacolp.mail.password}
    properties:
      mail:
        smtp:
          auth: true
          ssl:
            enable: true
          socketFactory:
            port: 465
            class: javax.net.ssl.SSLSocketFactory

server:
  servlet:
    session:
      timeout: 10m
      cookie:
        http-only: true
        same-site: lax
        # 生产环境必须通过 TLS 并设为 true；本地 HTTP 保持 false。
        secure: ${OAUTH_SESSION_COOKIE_SECURE:false}

management:
  endpoints:
    web:
      exposure:
        include: health
  endpoint:
    health:
      show-details: never
      probes:
        enabled: true

jacolp:
  # Profile-specific infrastructure settings.
  datasource:
    host: ${MYSQL_HOST:127.0.0.1}
    port: ${MYSQL_PORT:3306}
    database: ${MYSQL_DATABASE:personal_saas}
    username: ${MYSQL_USERNAME:root}
    password: ${MYSQL_PASSWORD:CHANGE_ME}
  redis:
    host: ${REDIS_HOST:127.0.0.1}
    port: ${REDIS_PORT:6379}
    password: ${REDIS_PASSWORD:}
  rabbitmq:
    host: ${RABBITMQ_HOST:127.0.0.1}
    port: ${RABBITMQ_PORT:5672}
    username: ${RABBITMQ_USERNAME:guest}
    password: ${RABBITMQ_PASSWORD:guest}
  elasticsearch:
    uris:
      - ${ELASTICSEARCH_URI:http://127.0.0.1:9200}
    username: ${ELASTICSEARCH_USERNAME:}
    password: ${ELASTICSEARCH_PASSWORD:}
    index:
      document: ${ELASTICSEARCH_DOCUMENT_INDEX:document}
      file: ${ELASTICSEARCH_FILE_INDEX:file}
  mail:
    host: ${SMTP_HOST:smtp.example.com}
    port: ${SMTP_PORT:465}
    username: ${SMTP_USERNAME:CHANGE_ME}
    password: ${SMTP_PASSWORD:CHANGE_ME}
  web:
    cors:
      # Narrow this list to the deployed frontend origins.
      allowed-origin-patterns: "${CORS_ALLOWED_ORIGIN_PATTERNS:http://localhost:5173}"
      allowed-methods: "${CORS_ALLOWED_METHODS:GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS}"
      allowed-headers: "${CORS_ALLOWED_HEADERS:*}"
      exposed-headers: "${CORS_EXPOSED_HEADERS:}"
      allow-credentials: ${CORS_ALLOW_CREDENTIALS:false}
      allow-private-network: ${CORS_ALLOW_PRIVATE_NETWORK:false}
      max-age: ${CORS_MAX_AGE:30m}
  messaging:
    enabled: ${MESSAGING_ENABLED:true}
    batch-size: ${MESSAGING_OUTBOX_BATCH_SIZE:100}
    shard-size: ${MESSAGING_SHARD_SIZE:100}
    max-retries: ${MESSAGING_MAX_RETRIES:8}
    poll-delay-ms: ${MESSAGING_POLL_DELAY_MS:1000}
    claim-seconds: ${MESSAGING_CLAIM_SECONDS:60}
    confirm-timeout-ms: ${MESSAGING_CONFIRM_TIMEOUT_MS:10000}
    retry-queue-delay-ms: ${MESSAGING_RETRY_DELAY_MS:10000}
    max-payload-bytes: ${MESSAGING_MAX_PAYLOAD_BYTES:262144}
    initial-backoff: ${MESSAGING_INITIAL_BACKOFF:2s}
    max-backoff: ${MESSAGING_MAX_BACKOFF:5m}
  admin:
    username: ${ADMIN_USERNAME:admin}
    password: ${ADMIN_PASSWORD:CHANGE_ME}
    email: ${ADMIN_EMAIL:admin@example.com}
  default-password: ${DEFAULT_PASSWORD:CHANGE_ME}  # 默认测试密码
  oauth2:
    browser-login:
      csrf-enabled: ${OAUTH2_BROWSER_LOGIN_CSRF_ENABLED:false}
    rs256:
      issuer: ${OAUTH2_RS256_ISSUER:core-node}
      audience: ${OAUTH2_RS256_AUDIENCE:core-node-api}
      private-key-location: ${OAUTH2_RS256_PRIVATE_KEY_LOCATION:file:./resource/key/oauth2-rs256-private.pem}
      public-key-location: ${OAUTH2_RS256_PUBLIC_KEY_LOCATION:file:./resource/key/oauth2-rs256-public.pem}
  jwt:
    active-secret-key: ${JWT_ACTIVE_SECRET_KEY:CHANGE_ME_TO_A_LONG_RANDOM_SECRET}
    active-ttl: 900000  # 15 分钟
    active-code-ttl: 300000  # 5 分钟
    active-token-name: ${JWT_ACTIVE_TOKEN_NAME:activeToken}
  markdown:
    root: ${MARKDOWN_ROOT:./data/markdown}
    input: ${MARKDOWN_INPUT_DIR:./data/markdown/input}
    output: ${MARKDOWN_OUTPUT_DIR:./data/markdown/output}
    input-dir: ${jacolp.markdown.input}
    output-dir: ${jacolp.markdown.output}
  app:
    # Must be the public frontend origin, not the backend's internal address.
    base-url: ${APP_BASE_URL:http://localhost:5173}
  base-url: ${jacolp.app.base-url}
  aliyun:
    oss:
      endpoint: ${ALIYUN_OSS_ENDPOINT:oss-cn-hangzhou.aliyuncs.com}
      bucket-name: ${ALIYUN_OSS_BUCKET_NAME:CHANGE_ME}
      region: ${ALIYUN_OSS_REGION:cn-hangzhou}
      keep-live-time: 45  # 单位是秒
      keep-live-enabled: ${OSS_KEEP_LIVE_ENABLED:false}
      enabled: true
  audio:
    callback-token: ${AUDIO_CALLBACK_TOKEN:CHANGE_ME}
    queue-type: ${AUDIO_QUEUE_TYPE:redis-stream}
  image:
    delete-image-task-time: 60  # 单位是分钟
  yjs-merge-service:
    base-url: ${YJS_MERGE_SERVICE_BASE_URL:http://127.0.0.1:3100}
  document:
    enabled: ${DOCUMENT_ENABLED:true}
    # v0.7 file 投影、Canal 增量和历史身份迁移都必须显式开启。
    file-index:
      enabled: ${DOCUMENT_FILE_INDEX_ENABLED:false}
      rebuild-on-start: ${DOCUMENT_FILE_INDEX_REBUILD_ON_START:false}
      canal:
        enabled: ${DOCUMENT_FILE_INDEX_CANAL_ENABLED:false}
        host: ${CANAL_HOST:127.0.0.1}
        port: ${CANAL_PORT:11111}
        destination: ${CANAL_DESTINATION:example}
        username: ${CANAL_USERNAME:}
        password: ${CANAL_PASSWORD:}
        filter: ${CANAL_FILTER:personal_saas[.].*}
        batch-size: ${CANAL_BATCH_SIZE:100}
        poll-delay-ms: ${CANAL_POLL_DELAY_MS:100}
    node-migration:
      run-on-start: ${DOCUMENT_NODE_MIGRATION_RUN_ON_START:false}
      page-size: ${DOCUMENT_NODE_MIGRATION_PAGE_SIZE:100}
      max-update-batch-bytes: ${DOCUMENT_NODE_MIGRATION_MAX_UPDATE_BATCH_BYTES:524288}
      max-cas-retries: ${DOCUMENT_NODE_MIGRATION_MAX_CAS_RETRIES:3}

aliyun:
  oss:
    endpoint: https://${jacolp.aliyun.oss.endpoint}
    bucket-name: ${jacolp.aliyun.oss.bucket-name}
    region: ${jacolp.aliyun.oss.region}

# 开启驼峰命名转换
mybatis:
  mapper-locations: classpath*:mapper/**/*.xml
  configuration:
    map-underscore-to-camel-case: true
